#!/usr/bin/env sh

# Skip the crawl when staged changes cannot affect site links.
if ! git diff --cached --name-only | grep -qE '^(content/|app/|components/|public/|lib/|scripts/check-links|scripts/audit-a11y-content|package\.json|package-lock\.json|next\.config)'; then
  exit 0
fi

npm run check-links
npm run audit-a11y-content
